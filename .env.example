# Crie o bot no @BotFather. Não compartilhe este token.
TELEGRAM_BOT_TOKEN=
BOT_TIMEZONE=America/Sao_Paulo
BOT_DB_PATH=./data/zelumi.sqlite

# Gerado automaticamente por npm run cf:secrets ao migrar para Cloudflare.
TELEGRAM_WEBHOOK_SECRET=

# Somente para o proxy Vercel; valor independente, aleatório, de 64 caracteres hexadecimais.
# Configurar o mesmo valor na Vercel, sem prefixo NEXT_PUBLIC_. Não compartilhar pelo chat.
VERCEL_PROXY_SECRET=
