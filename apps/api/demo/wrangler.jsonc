{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "zelumi-demo",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "DEMO_ENABLED": "true",
    "APP_ORIGIN": "https://zelumi-demo.zelumi.workers.dev",
    "TELEGRAM_BOT_TOKEN": "999001:public_demo_only",
    "TELEGRAM_BOT_USERNAME": "zelumi_demo_bot",
    "BOT_TIMEZONE": "America/Sao_Paulo",
    "CATEGORY_AI_ENABLED": "false"
  },
  "assets": {
    "directory": "../../../build/demo-assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/auth",
      "/auth/*",
      "/api",
      "/api/*",
      "/telegram/*",
      "/health"
    ],
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zelumi-public-demo",
      "database_id": "93e57019-367e-4da6-99bf-8913120061d1",
      "migrations_dir": "../migrations"
    }
  ],
  "dev": {
    "ip": "127.0.0.1",
    "port": 8789,
    "local_protocol": "https"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}
