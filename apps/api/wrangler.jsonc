{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "zelumi-bot",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "BOT_TIMEZONE": "America/Sao_Paulo",
    "CATEGORY_AI_ENABLED": "true",
    "CATEGORY_AI_PLAN": "free",
    "CATEGORY_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "CATEGORY_AI_DAILY_LIMIT": "200",
    "CATEGORY_AI_USER_DAILY_LIMIT": "20",
    "APP_ORIGIN": "https://usezelumi.vercel.app",
    "TELEGRAM_BOT_USERNAME": "zelumi_bot"
  },
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/auth",
      "/auth/*",
      "/api",
      "/api/*",
      "/telegram/webhook",
      "/health"
    ],
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "https"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zelumi",
      "database_id": "d3f02fd4-11d2-46f9-8f37-bb06ae00752e",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}
