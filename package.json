{
  "name": "zelumi",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "bot": "node --env-file-if-exists=.env bot/index.mjs",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build && node scripts/check-web-export.mjs",
    "web:check": "npm --prefix web run typecheck && npm --prefix web test && npm run web:build",
    "cf:login": "node scripts/cloudflare.mjs login",
    "cf:whoami": "node scripts/cloudflare.mjs whoami",
    "cf:db:create": "node scripts/cloudflare.mjs db:create",
    "cf:db:migrate": "node scripts/cloudflare.mjs db:migrate",
    "cf:db:migrate:local": "node scripts/cloudflare.mjs db:migrate:local",
    "cf:db:pending": "node scripts/cloudflare.mjs db:pending",
    "cf:versions": "node scripts/cloudflare.mjs versions",
    "cf:check": "node scripts/cloudflare.mjs check",
    "cf:dev": "node scripts/cloudflare.mjs dev",
    "cf:deploy": "node scripts/cloudflare.mjs deploy",
    "cf:secrets": "node scripts/cloudflare.mjs secrets",
    "cf:activate": "node scripts/cloudflare.mjs activate",
    "cf:webhook:status": "node scripts/cloudflare.mjs webhook:status",
    "cf:db:import": "node scripts/cloudflare.mjs db:import",
    "cf:export-local": "node scripts/export-local.mjs"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "devDependencies": {
    "wrangler": "^4.156.1"
  }
}
