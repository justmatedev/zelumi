{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build && node ../scripts/check-web-export.mjs",
  "outputDirectory": "out",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer",
        "X-Frame-Options": "SAMEORIGIN",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/(?!telegram-widget(?:\\.html)?/?$|auth(?:/|$)|api(?:/|$)).*",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'self'"
      },
      "continue": true
    },
    {
      "src": "/telegram-widget(?:\\.html)?/?",
      "headers": {
        "Content-Security-Policy": "default-src 'none'; script-src 'self' https://telegram.org 'unsafe-eval'; style-src 'unsafe-inline'; frame-src https://oauth.telegram.org; connect-src 'none'; frame-ancestors 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
      },
      "continue": true
    },
    {
      "src": "/((?:auth|api)(?:/.*)?)",
      "dest": "https://financeiro-testes-bot.miudo.workers.dev/$1",
      "headers": {
        "Cache-Control": "no-store",
        "CDN-Cache-Control": "no-store",
        "Vercel-CDN-Cache-Control": "no-store",
        "x-vercel-enable-rewrite-caching": "0"
      },
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {"key": "X-Zelumi-Proxy-Secret"},
          "args": "$VERCEL_PROXY_SECRET",
          "env": ["VERCEL_PROXY_SECRET"]
        }
      ]
    },
    {"src": "/_next/static/(.*)", "headers": {"Cache-Control": "public, max-age=31536000, immutable"}, "continue": true},
    {"src": "/_headers", "dest": "/404.html", "status": 404},
    {"handle": "filesystem"},
    {"src": "/(visao-geral|lancamentos|perfil)/?", "dest": "/$1/index.html"},
    {"src": "/telegram-widget/?", "dest": "/telegram-widget.html"},
    {"src": "/(.*)", "dest": "/404.html", "status": 404}
  ]
}
