{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "financeiro-testes-bot",
	"main": "cloudflare/worker.mjs",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"preview_urls": false,
	"vars": {
		"BOT_TIMEZONE": "America/Sao_Paulo",
		"APP_ORIGIN": "https://financeiro-testes-bot.miudo.workers.dev",
		"TELEGRAM_BOT_USERNAME": "financeiro_lab_482_bot"
	},
	"assets": {
		"directory": "./web/out",
		"binding": "ASSETS",
		"run_worker_first": ["/auth", "/auth/*", "/api", "/api/*", "/telegram/webhook", "/health"],
		"html_handling": "force-trailing-slash",
		"not_found_handling": "404-page"
	},
	"dev": { "ip": "127.0.0.1", "port": 8787, "local_protocol": "https" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "financeiro-testes",
			"database_id": "5475e8b9-7232-4ef2-82bb-0e06b38ee5fb",
			"migrations_dir": "cloudflare/migrations"
		}
	],
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"observability": {
		"enabled": false
	}
}
